generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "rhel-openssl-1.1.x"]
  engineType = "library"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_URL")
}

// ======================
// Core Enums
// ======================

enum Role {
  admin
  coach
  trainee
}

enum BookingStatus {
  confirmed
  cancelled
  no_show
  completed
}

// ======================
// Core Models
// ======================

model user {
  id        String    @id // clerkId will be used as the primary key
  email     String    @unique
  name      String?
  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  role      Role      @default(trainee)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  instructor    Instructor?
  classBookings ClassBooking[]
  memberships   UserMembership[]
  faceProfile   FaceProfile?

  // Credits feature (parallel to memberships; booking-only, never expires)
  creditWallet       CreditWallet?
  creditTransactions CreditTransaction[]
}

// ======================
// Boxing Gym Booking Models
// ======================

model GymClassType {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  description     String?
  duration        Int      // minutes
  defaultCapacity Int      @default(12)
  isOpenGym       Boolean  @default(false)
  color           String?  // hex for UI
  // Number of credits a credit-pack member spends to book a class of this
  // type. Defaults to 1. Does not affect membership/flexi bookings.
  creditCost      Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions  ClassSession[]
  templates ClassTemplate[]

  @@map("gym_class_types")
}

model Instructor {
  id        String   @id @default(cuid())
  name      String
  userId    String?  @unique
  user      user?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  specialty String?
  bio       String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  ClassSession[]
  templates ClassTemplate[]

  @@map("instructors")
}

model ClassSession {
  id           String         @id @default(cuid())
  classTypeId  String
  classType    GymClassType   @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  capacity     Int
  bookedCount  Int            @default(0)
  templateId   String?
  template     ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isCancelled  Boolean        @default(false)
  cancelReason String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  bookings ClassBooking[]

  @@index([startTime])
  @@map("class_sessions")
}

model ClassBooking {
  id               String        @id @default(cuid())
  sessionId        String
  session          ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guestName        String
  guestEmail       String
  guestPhone       String?
  userId           String?
  user             user?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           BookingStatus @default(confirmed)
  attended         Boolean       @default(true) // Auto-attended unless marked absent
  confirmationCode String        @unique @default(cuid())
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessionUsage SessionUsage?

  @@unique([sessionId, guestEmail])
  @@index([guestEmail])
  @@index([confirmationCode])
  @@map("class_bookings")
}

model ClassTemplate {
  id           String       @id @default(cuid())
  classTypeId  String
  classType    GymClassType @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int          // 0=Sunday, 1=Monday...
  startTime    String       // "09:00" 24h format
  endTime      String
  capacity     Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions ClassSession[]

  @@map("class_templates")
}

enum GymClosureType {
  holiday
  maintenance
  emergency
  training
  event
  closure
  other
}

model GymClosure {
  id        String         @id @default(cuid())
  date      DateTime
  startTime String?        // null means all day
  endTime   String?        // null means all day
  reason    String?
  type      GymClosureType @default(closure)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("gym_closures")
}

// ======================
// Membership & Stripe Integration Models
// ======================

enum MembershipPlanType {
  FREE_TRIAL
  TRIAL_CLASS
  TRIAL_WEEK
  // Flexi Packages
  FLEXI_ADULT_5
  FLEXI_ADULT_10
  FLEXI_YOUTH_5
  FLEXI_YOUTH_10
  FLEXI_JUNIOR_5
  FLEXI_JUNIOR_10
  // Monthly - Adult
  MONTHLY_ADULT_1YR
  MONTHLY_ADULT_1YR_DEPRECATED
  MONTHLY_ADULT_6MO
  MONTHLY_ADULT_3MO
  MONTHLY_ADULT
  // Monthly - Student
  MONTHLY_STUDENT_1YR
  MONTHLY_STUDENT_6MO
  MONTHLY_STUDENT_3MO
  MONTHLY_STUDENT
  // Muay Thai student, 12-month commitment ($128/mo, old payment link)
  MONTHLY_STUDENT_MT_1YR
  // Monthly - NSF/NSMEN
  MONTHLY_NSF_1YR
  MONTHLY_NSF_6MO
  MONTHLY_NSF_3MO
  MONTHLY_NSF
  // Monthly - Junior
  MONTHLY_JUNIOR_1YR
  MONTHLY_JUNIOR_6MO
  MONTHLY_JUNIOR_3MO
  MONTHLY_JUNIOR
}

enum MembershipCategory {
  FLEXI_PACKAGE
  MONTHLY_SUBSCRIPTION
  TRIAL
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
  PENDING_PAYMENT
}

model MembershipPlan {
  id                      String             @id @default(cuid())
  planType                MembershipPlanType @unique
  category                MembershipCategory
  name                    String
  stripePriceId           String             @unique
  stripeProductId         String
  sessionsIncluded        Int?               // null = unlimited
  commitmentMonths        Int?
  expiryDays              Int?               // For short-term plans (e.g., 7 = 1 week trial)
  priceInCents            Int
  isActive                Boolean            @default(true)
  // When true, members on this plan can only enter the gym during a
  // booked session window. When false (default), they may enter any
  // time their membership is active.
  requiresBookingForEntry Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  userMemberships UserMembership[]

  @@map("membership_plans")
}

model UserMembership {
  id                   String           @id @default(cuid())
  userId               String
  user                 user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan   @relation(fields: [planId], references: [id])
  stripeCustomerId     String?          // Can be null for some checkout types
  stripeSubscriptionId String?
  paymentMethod        String?          // e.g., "card", "paynow", "grabpay"
  paymentMethodDetails String?          // e.g., "visa •••• 4242" or "PayNow"
  status               MembershipStatus @default(PENDING_PAYMENT)
  sessionsRemaining    Int?
  sessionsUsed         Int              @default(0)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  commitmentEndDate    DateTime?
  activatedAt          DateTime?
  expiresAt            DateTime?        // Flexi expires 6 months from purchase
  cancelledAt          DateTime?
  // Last time we emailed the user about a denied door scan. Used to
  // throttle access-denied notifications to one per calendar day.
  lastAccessNotifiedAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sessionUsages SessionUsage[]

  @@index([userId])
  @@index([stripeCustomerId])
  @@map("user_memberships")
}

model SessionUsage {
  id           String         @id @default(cuid())
  membershipId String
  membership   UserMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bookingId    String         @unique
  booking      ClassBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  usedAt       DateTime       @default(now())

  @@map("session_usages")
}

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@map("stripe_events")
}

// ======================
// Credits Feature Models
// ======================
//
// Credits are a standalone, never-expiring "class pack" wallet that runs in
// parallel to memberships. Buying a CreditProduct grants credits; booking a
// class spends GymClassType.creditCost credits. Credits do NOT grant gym door
// access and never create a UserMembership.

enum CreditTransactionType {
  PURCHASE       // bought a credit pack via Stripe
  BOOKING_SPEND  // spent on a class booking
  BOOKING_REFUND // booking cancelled, credits returned
  ADMIN_ADJUST   // manual grant/revoke by an admin
}

// Admin-managed mapping of a Stripe product to a credit grant. The webhook
// looks this up by stripeProductId; a hit grants credits (and skips the
// membership path entirely).
model CreditProduct {
  id              String   @id @default(cuid())
  // Either of these may be set; the webhook matches a purchase on whichever
  // is filled in (product id OR price id). At least one must be present.
  stripeProductId String?  @unique
  stripePriceId   String?  @unique
  name            String
  creditsGranted  Int
  priceInCents    Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions CreditTransaction[]

  @@map("credit_products")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // never negative, never expires
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CreditTransaction[]

  @@map("credit_wallets")
}

// Append-only ledger. A booking is paid by EITHER a SessionUsage (membership)
// OR a BOOKING_SPEND CreditTransaction (credits), never both — so cancellation
// knows which source to refund. bookingId is unique to enforce that.
model CreditTransaction {
  id           String                @id @default(cuid())
  walletId     String
  wallet       CreditWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId       String // denormalized for per-user queries
  user         user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CreditTransactionType
  amount       Int // signed: +grant / -spend
  balanceAfter Int // running balance snapshot
  reason       String?
  bookingId    String?               @unique // set for BOOKING_SPEND / BOOKING_REFUND
  productId    String?
  product      CreditProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourceRef    String? // Stripe event/session id, or admin userId
  createdAt    DateTime              @default(now())

  @@index([userId])
  @@index([walletId])
  @@map("credit_transactions")
}

// ======================
// Face Enrollment (Hikvision Integration)
// ======================

enum FaceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FaceSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

model FaceProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceImageUrl        String
  faceImageS3Key      String
  hikvisionEmployeeNo String             @unique
  approvalStatus      FaceApprovalStatus @default(PENDING)
  syncStatus          FaceSyncStatus     @default(PENDING)
  syncError           String?
  syncedAt            DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  uploadedByAdminId   String?            // null = self-uploaded, else admin userId
  // Reconciler tracking: true when door rights are believed to be
  // applied on every camera, false when access has been revoked
  // (face remains but doorRight is empty). Lets the reconciler skip
  // bridge calls when the desired state already matches.
  accessGrantedOnCamera Boolean          @default(true)
  // Last AccessReason produced by evaluateAccess. Stored for the
  // admin UI so it can show *why* a member's access is revoked
  // without re-querying.
  lastAccessReason    String?
  // When the reconciler last ran for this profile (regardless of
  // whether it had to do anything).
  reconciledAt        DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([approvalStatus])
  @@map("face_profiles")
}

// ======================
// Hikvision Device & Access Events
// ======================

model HikvisionDevice {
  id                String        @id @default(cuid())
  name              String        // e.g., "Main Entrance"
  ipAddress         String
  port              Int           @default(80)
  username          String
  encryptedPassword String        // AES-encrypted via HIKVISION_ENCRYPTION_KEY
  isActive          Boolean       @default(true)
  lastSyncedAt      DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  accessEvents      AccessEvent[]

  @@map("hikvision_devices")
}

enum AccessDecision {
  GRANTED
  DENIED
  UNKNOWN
}

model AccessEvent {
  id              String          @id @default(cuid())
  deviceId        String?
  device          HikvisionDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  employeeNo      String?         // hikvisionEmployeeNo from camera
  userId          String?         // resolved from FaceProfile.hikvisionEmployeeNo
  userName        String?         // snapshot of name at scan time
  eventType       String?         // raw event code from camera
  decision        AccessDecision  @default(UNKNOWN)
  similarity      Float?          // recognition confidence 0..100
  capturedImageUrl String?        // optional snapshot from camera
  rawPayload      Json?           // full webhook body for debugging
  // Server-side judgement of whether the user *should* have been
  // granted access at scan time, in the form of an AccessReason
  // string (see services/accessControl.ts). The camera makes its
  // own decision; this records what the cloud thought.
  membershipStateAtScan String?
  occurredAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([deviceId])
  @@index([userId])
  @@index([occurredAt])
  @@map("access_events")
}
