generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "rhel-openssl-1.1.x"]
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_URL")
}

// ======================
// Core Enums
// ======================

enum Role {
  admin
  staff
  customer
}

enum BookingStatus {
  confirmed
  cancelled
  no_show
  completed
}

// ======================
// Core Models
// ======================

model user {
  id          String   @id // clerkId will be used as the primary key
  email       String   @unique
  name        String?
  firstName   String?
  lastName    String?
  phone       String?
  avatar      String?
  role        Role     @default(customer)
  teamId      String?
  team        team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  instructors   Instructor[]
  classBookings ClassBooking[]
  memberships   UserMembership[]
}

model team {
  id            String         @id @default(cuid())
  name          String
  users         user[]
  branches      branch[]
  gymClassTypes GymClassType[]
  closures      GymClosure[]
  createdAt     DateTime       @default(now())
}

model branch {
  id        String   @id @default(cuid())
  name      String
  location  String
  latitude  Float?
  longitude Float?
  teamId    String
  team      team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  instructors   Instructor[]
  classSessions ClassSession[]
}

// ======================
// Boxing Gym Booking Models
// ======================

model GymClassType {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  description     String?
  duration        Int      // minutes
  defaultCapacity Int      @default(12)
  isOpenGym       Boolean  @default(false)
  color           String?  // hex for UI
  teamId          String
  team            team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions  ClassSession[]
  templates ClassTemplate[]

  @@map("gym_class_types")
}

model Instructor {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  user      user?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId  String
  branch    branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  specialty String?
  bio       String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  ClassSession[]
  templates ClassTemplate[]

  @@map("instructors")
}

model ClassSession {
  id           String         @id @default(cuid())
  classTypeId  String
  classType    GymClassType   @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  branchId     String
  branch       branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  capacity     Int
  bookedCount  Int            @default(0)
  templateId   String?
  template     ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isCancelled  Boolean        @default(false)
  cancelReason String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  bookings ClassBooking[]

  @@index([startTime])
  @@index([branchId, startTime])
  @@map("class_sessions")
}

model ClassBooking {
  id               String        @id @default(cuid())
  sessionId        String
  session          ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guestName        String
  guestEmail       String
  guestPhone       String?
  userId           String?
  user             user?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           BookingStatus @default(confirmed)
  confirmationCode String        @unique @default(cuid())
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessionUsage SessionUsage?

  @@unique([sessionId, guestEmail])
  @@index([guestEmail])
  @@index([confirmationCode])
  @@map("class_bookings")
}

model ClassTemplate {
  id           String       @id @default(cuid())
  classTypeId  String
  classType    GymClassType @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  branchId     String
  dayOfWeek    Int          // 0=Sunday, 1=Monday...
  startTime    String       // "09:00" 24h format
  endTime      String
  capacity     Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions ClassSession[]

  @@map("class_templates")
}

model GymClosure {
  id        String   @id @default(cuid())
  teamId    String
  team      team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String?  // null means all day
  endTime   String?  // null means all day
  reason    String?
  createdAt DateTime @default(now())

  @@map("gym_closures")
}

// ======================
// Membership & Stripe Integration Models
// ======================

enum MembershipPlanType {
  FREE_TRIAL
  // Flexi Packages
  FLEXI_ADULT_5
  FLEXI_ADULT_10
  FLEXI_YOUTH_5
  FLEXI_YOUTH_10
  FLEXI_JUNIOR_5
  FLEXI_JUNIOR_10
  // Monthly - Adult
  MONTHLY_ADULT_1YR
  MONTHLY_ADULT_6MO
  MONTHLY_ADULT_3MO
  MONTHLY_ADULT
  // Monthly - Student
  MONTHLY_STUDENT_1YR
  MONTHLY_STUDENT_6MO
  MONTHLY_STUDENT_3MO
  MONTHLY_STUDENT
  // Monthly - NSF/NSMEN
  MONTHLY_NSF_1YR
  MONTHLY_NSF_6MO
  MONTHLY_NSF_3MO
  MONTHLY_NSF
  // Monthly - Junior
  MONTHLY_JUNIOR_1YR
  MONTHLY_JUNIOR_6MO
  MONTHLY_JUNIOR_3MO
  MONTHLY_JUNIOR
}

enum MembershipCategory {
  FLEXI_PACKAGE
  MONTHLY_SUBSCRIPTION
  TRIAL
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
  PENDING_PAYMENT
}

model MembershipPlan {
  id               String             @id @default(cuid())
  planType         MembershipPlanType @unique
  category         MembershipCategory
  name             String
  stripePriceId    String             @unique
  stripeProductId  String
  sessionsIncluded Int?               // null = unlimited
  commitmentMonths Int?
  priceInCents     Int
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  userMemberships UserMembership[]

  @@map("membership_plans")
}

model UserMembership {
  id                   String           @id @default(cuid())
  userId               String
  user                 user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan   @relation(fields: [planId], references: [id])
  stripeCustomerId     String
  stripeSubscriptionId String?
  status               MembershipStatus @default(PENDING_PAYMENT)
  sessionsRemaining    Int?
  sessionsUsed         Int              @default(0)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  commitmentEndDate    DateTime?
  activatedAt          DateTime?
  expiresAt            DateTime?        // Flexi expires 6 months from purchase
  cancelledAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sessionUsages SessionUsage[]

  @@index([userId])
  @@index([stripeCustomerId])
  @@map("user_memberships")
}

model SessionUsage {
  id           String         @id @default(cuid())
  membershipId String
  membership   UserMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bookingId    String         @unique
  booking      ClassBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  usedAt       DateTime       @default(now())

  @@map("session_usages")
}

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@map("stripe_events")
}
